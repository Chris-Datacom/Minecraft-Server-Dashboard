# Copy to .env for local development. Never commit .env or real credentials.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_SESSION_SECRET=
DATABASE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
DISCORD_ADMIN_USER_IDS=
SERVER_CREDENTIALS_KEY=
MINECRAFT_ALLOWED_HOSTS=
HOSTED_SERVER_ALLOWED_HOSTS=
# Automated creation remains off until the separate worker and prepared template are deployed.
HOSTING_ENABLED=false
HOSTING_DOMAIN=krumpy.xyz
HOSTING_IP_START=10.0.0.201
HOSTING_IP_END=10.0.0.220
# Worker-only settings belong in its protected EnvironmentFile, not the public app's .env.
# DATABASE_URL must use the dedicated provisioner role; SERVER_CREDENTIALS_KEY must match the website.
# HOSTING_PROXMOX_URL=https://10.0.0.12:8006/api2/json
# HOSTING_PROXMOX_TLS_NAME=pve02.krumpy.xyz
# HOSTING_PROXMOX_CA_FILE=/etc/blockhost/pve-root-ca.pem
# HOSTING_PROXMOX_TOKEN_ID=
# HOSTING_PROXMOX_TOKEN_SECRET=
# HOSTING_PROXMOX_NODES=pve02,pve03
# HOSTING_TEMPLATE_ID=9001
# HOSTING_STORAGE=truenas
# HOSTING_PROXMOX_POOL=blockhost-managed
# HOSTING_STATE_DIR=/var/lib/blockhost-provisioner
# HOSTING_GATEWAY_IP=10.0.0.1
# HOSTING_WEBSITE_IP=10.0.0.65
# HOSTING_VELOCITY_VMID=116
# HOSTING_FORWARDING_SECRET=
# HOSTING_CLOUDFLARE_TOKEN=
# HOSTING_CLOUDFLARE_ZONE=
# HOSTING_PUBLIC_IP=
# The worker needs its own source-restricted SFTPGo API identity with user deletion permission.
# SFTP_GATEWAY_API_USER=blockhost-provisioner
# SFTP_GATEWAY_API_PASSWORD=
# Optional shared SFTP gateway; configure every non-public gateway field together.
SFTP_GATEWAY_HOST=
SFTP_GATEWAY_FINGERPRINT=
SFTP_GATEWAY_ACCESS_FINGERPRINT=
SFTP_GATEWAY_ACCESS_KEY_FILE=
SFTP_GATEWAY_API_URL=
SFTP_GATEWAY_CA_FILE=
SFTP_GATEWAY_API_USER=
SFTP_GATEWAY_API_PASSWORD=
SFTP_GATEWAY_PUBLIC_HOST=sftp.krumpy.xyz
SFTP_GATEWAY_PUBLIC_PORT=37002
SFTP_TRUST_CLOUDFLARE=false
VELOCITY_STATUS_HOST=
VELOCITY_STATUS_PORT=37001
PROXMOX_API_URL=https://proxmox.example:8006/api2/json/
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VM_ID=
PROXMOX_VM_NAME=
